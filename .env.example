# DeepSeek（也可在前端「设置」页修改，写入本文件）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 微信读书 Agent Gateway（格式 wrk-xxxxxxxx）
WEREAD_API_KEY=

# 系统门禁（设置 AUTH_PASSWORD 后启用；前端启动需先登录）
AUTH_USERNAME=admin
AUTH_PASSWORD=
# 可选：自定义会话签名密钥；留空则由用户名+密码派生
# AUTH_SECRET=
# 可选：强制 cookie Secure（true/false）；留空则按请求是否 HTTPS 自动
# AUTH_COOKIE_SECURE=

# CORS（一般不用改）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
