[Unit]
Description=AI Native Visual Learning System API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ai-native-visual-learning-system/apps/api
EnvironmentFile=/home/ubuntu/ai-native-visual-learning-system/.env
Environment=PATH=/home/ubuntu/ai-native-visual-learning-system/apps/api/.venv/bin:/usr/local/bin:/usr/bin
ExecStart=/home/ubuntu/ai-native-visual-learning-system/apps/api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
